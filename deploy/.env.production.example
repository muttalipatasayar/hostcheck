# HostCheck — ÜRETİM ortam değişkenleri
# /opt/hostcheck/backend/.env olarak kopyalayın ve düzenleyin.

# ── Çalışma ortamı ────────────────────────────────────────────────────────────
# production → /docs KAPALI, Chromium sandbox ETKİN (güvenli)
ENV=production

# ── CORS — panelin servis edildiği subdomain ─────────────────────────────────
# Frontend ile backend aynı origin'den (Nginx) servis edildiği için CORS
# aslında tetiklenmez; yine de yalnızca kendi subdomain'inizi yazın.
CORS_ORIGINS=https://panel.ornek.com

# ── FTP dosya yöneticisi limitleri ────────────────────────────────────────────
MAX_UPLOAD_BYTES=536870912
MAX_LIST_ENTRIES=5000
MAX_INLINE_EDIT_BYTES=1048576

# ── Opsiyonel: DNS History için tam NS geçmişi ───────────────────────────────
SECURITYTRAILS_API_KEY=

# ── Opsiyonel: Site Hızı — Google resmî skoru + CrUX saha verisi ─────────────
# Boş bırakılabilir; kendi ölçüm motorumuz anahtarsız çalışır. Anahtarsız
# Google çağrısı denenmemelidir (paylaşılan kota kalıcı olarak 0 → 429).
# Cloud projesinde HEM "PageSpeed Insights API" HEM "Chrome UX Report API"
# etkinleştirilmelidir.
PAGESPEED_API_KEY=

# NOT: Sunucu 127.0.0.1:8000'de dinler (systemd ExecStart). Dışarıya açılış
# yalnızca Nginx üzerinden HTTPS + Basic Auth ile olur. Bu binding'i
# 0.0.0.0'a ÇEVİRMEYİN — SSH/RDP/FTP uçları auth'suz açığa çıkar.
