# Bu kuruluma özgü değerler. `yerel.env` adıyla kopyalayıp doldurun:
#
#   cp deploy/yerel.env.ornek deploy/yerel.env && $EDITOR deploy/yerel.env
#
# `deploy/yerel.env` .gitignore'dadır ve DEPOYA GİRMEZ. Gerçek alan adı,
# yönetici adresi ve sunucu yolları burada kalır; depo herkese açık olsa bile
# altyapı bilgisi dışarı sızmaz.

# Panelin dışarıdan görünen adresi (şema dahil, sondaki eğik çizgi olmadan)
PANEL_URL=https://panel.ornek.com

# Nginx site dosyası ve web kökü — genelde alan adıyla aynı isimli
NGINX_SITE=/etc/nginx/sites-available/panel.ornek.com
WEB_KOKU=/var/www/panel.ornek.com

# Kaynak deposunun sunucudaki yolu
SRC=/home/kullanici/hostcheck-src

# Sunucu tarafından sabitlenen yönetici(ler), virgülle ayrılır.
# Bu adres(ler) doğrulandığı anda yönetici olur ve PANELDEN DÜŞÜRÜLEMEZ.
# Boş bırakılırsa hiç yönetici olmaz — betik dağıtımı durdurur.
ADMIN_EPOSTALARI=yonetici@sirketiniz.com

# Üye olabilecek e-posta alan adları (tam eşleşme, virgülle ayrılır)
IZINLI_MAIL_ALANLARI=sirketiniz.com
