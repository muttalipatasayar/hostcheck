# ── Çalışma ortamı ────────────────────────────────────────────────────────────
# development  → /docs açık, Chromium --no-sandbox ile başlar (yerel geliştirme)
# production   → /docs kapalı, Chromium sandbox etkin
ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend'in çalıştığı adres(ler) — virgülle ayrılır
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FTP dosya yöneticisi limitleri ────────────────────────────────────────────
# Tek dosya yükleme üst sınırı (bayt) — varsayılan 512 MB
MAX_UPLOAD_BYTES=536870912
# Dizin listelemede dönen en fazla girdi; aşılırsa yanıt truncated: true taşır
MAX_LIST_ENTRIES=5000
# Satır içi metin düzenleyicinin açabileceği en büyük dosya (bayt) — 1 MB
MAX_INLINE_EDIT_BYTES=1048576

# ── Opsiyonel harici servisler ────────────────────────────────────────────────
# DNS History sekmesinde tam NS değişim geçmişi için: https://securitytrails.com/
SECURITYTRAILS_API_KEY=

# NOT: Sunucunun dinlediği adres burada değil, başlatma komutunda belirlenir
# (start.bat / start-backend.bat içindeki --host). Panelde kimlik doğrulama
# YOKTUR; 127.0.0.1 dışına açarsanız ağdaki herkes SSH/RDP tünellerini ve
# veritabanını kullanabilir.
