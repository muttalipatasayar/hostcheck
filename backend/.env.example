# ── Çalışma ortamı ────────────────────────────────────────────────────────────
# development  → /docs açık, Chromium --no-sandbox ile başlar (yerel geliştirme)
# production   → /docs kapalı, Chromium sandbox etkin
ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend'in çalıştığı adres(ler) — virgülle ayrılır
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FTP dosya yöneticisi limitleri ────────────────────────────────────────────
# Tek dosya yükleme üst sınırı (bayt) — varsayılan 512 MB
MAX_UPLOAD_BYTES=536870912
# Dizin listelemede dönen en fazla girdi; aşılırsa yanıt truncated: true taşır
MAX_LIST_ENTRIES=5000
# Satır içi metin düzenleyicinin açabileceği en büyük dosya (bayt) — 1 MB
MAX_INLINE_EDIT_BYTES=1048576

# ── Opsiyonel harici servisler ────────────────────────────────────────────────
# DNS History sekmesinde tam NS değişim geçmişi için: https://securitytrails.com/
SECURITYTRAILS_API_KEY=

# Site Hızı sekmesinde Google'ın RESMÎ skorunu ve gerçek kullanıcı verisini
# (CrUX — INP dahil) da göstermek için. BOŞ BIRAKILABİLİR: kendi ölçüm
# motorumuz anahtarsız çalışır, yalnızca Google bölümleri gizlenir.
#
# Anahtarsız çağrı DENENMEMELİDİR — Google anonim kullanımı paylaşılan bir
# projeye yazıyor ve o projenin günlük kotası kalıcı olarak 0; her istek
# anında 429 döner.
#
# Anahtar: https://console.cloud.google.com → yeni proje → API'ler ve
# Hizmetler → şu İKİ API'yi de etkinleştirin:
#   • PageSpeed Insights API   (25.000 sorgu/gün, ücretsiz)
#   • Chrome UX Report API     (150 sorgu/dakika, ücretsiz, ayrı kota)
# Tek anahtar ikisini de açar.
PAGESPEED_API_KEY=

# NOT: Sunucunun dinlediği adres burada değil, başlatma komutunda belirlenir.
# Panelde kimlik doğrulaması YALNIZCA Hazır Yanıtlar ve Yönetim bölümlerini
# kapsar (üyelik); DNS/SSL/IP araçları herkese açıktır ve SSH/RDP/FTP hâlâ
# Nginx Basic Auth ile korunur. 127.0.0.1 dışına ters proxy OLMADAN açarsanız
# ağdaki herkes SSH/RDP tünellerini kullanabilir.

# ── Üyelik ────────────────────────────────────────────────────────────────────
# Üye olabilecek e-posta alan adları — virgülle ayrılır. TAM eşleşme yapılır:
# `natro.com` yazmak `mail.natro.com` veya `natro.com.baska.net` adreslerini
# KABUL ETMEZ. Alt alan adı gerekiyorsa listeye ayrıca eklenmeli.
IZINLI_MAIL_ALANLARI=natro.com,team.blue

# Sunucu tarafından sabitlenen yönetici(ler). Bu adresler doğrulandıkları anda
# yönetici olur ve panelden ASLA düşürülemez/silinemez — iki yöneticinin
# birbirini kilitlemesini önler.
ADMIN_EPOSTALARI=yonetici@sirketiniz.com

# Oturum ömrü. "Beni hatırla" işaretlenmezse çerez tarayıcı kapanınca da düşer.
OTURUM_SURESI_SAAT=12
OTURUM_UZUN_SURE_GUN=30

# ── E-posta (Brevo SMTP — ücretsiz katman 300 mail/gün) ───────────────────────
# Doğrulama ve parola sıfırlama bağlantılarının tabanı. Panelin dışarıdan
# görünen adresi olmalı; maillerdeki linkler bununla kurulur.
PUBLIC_BASE_URL=https://panel.ornek.com

# Brevo → SMTP & API → SMTP anahtarı. SMTP_USER hesabın giriş e-postası,
# SMTP_PASS üretilen anahtardır (hesap parolası DEĞİL).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ÖNEMLİ: MAIL_FROM, Brevo'da DOĞRULANMIŞ bir gönderici olmalı ve SPF/DKIM'i
# kurulu bir alan adına ait olmalı. `natro.com` bizim DNS'imiz değil; oradan
# gönderirsek Microsoft 365 doğrudan karantinaya atar ve doğrulama e-postası
# hiç ulaşmaz.
MAIL_FROM=
MAIL_FROM_NAME=HostCheck Destek Paneli

# SMTP_USER/SMTP_PASS boş ve ENV=development ise mail GÖNDERİLMEZ; içerik
# backend/data/mail-out/ altına .eml olarak yazılır (geliştirme kolaylığı).
# ENV=production ve SMTP eksikse kayıt ucu 503 döner.
